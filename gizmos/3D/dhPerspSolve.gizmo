version 17.0 v1
Group {
 help "Turns dhPerspGuide nodes into a camera.\n\nConnect it below two or three guides and it links itself. From their vanishing points it solves the focal length, the tilt, the pan and the roll, draws the horizon, and draws the ground plane through the solve so you can see whether it is right. If the grid lies flat on the floor in the plate, the camera is good.\n\nA photograph has no scale of its own, so set the camera height on the Scale tab. That is the one measurement that turns the solve into a real scene, and nothing else about the solve changes when you do it.\n\nThen press export camera. The exported camera stays linked, so it keeps following the guides, frame by frame if you have animated them, until you press bake values on it.\n\nWorth knowing: this reads a straight edge as a straight line, and a real lens bends them a little, most in the corners of frame and most on a wide lens. Usually too small to matter. If a wide plate gives an answer you cannot make sit right, undistorting it first is the thing to try."
 name dhPerspSolve
 onCreate "try:\n    import dhPersp\n    dhPersp.on_create_solve(nuke.thisNode())\nexcept Exception:\n    pass"
 knobChanged "try:\n    import dhPersp\n    dhPersp.on_knob_changed(nuke.thisNode(), nuke.thisKnob())\nexcept Exception:\n    pass"
 addUserKnob {20 main l Horizon}
 addUserKnob {7 _build l "" +INVISIBLE}
 _build 25
 addUserKnob {6 show_horizon l "show horizon line" -STARTLINE}
 show_horizon true
 addUserKnob {19 horizoncolor l color}
 horizoncolor {0 1 1 1}
 addUserKnob {7 horizonwidth l "line width" R 0.5 10}
 horizonwidth 2
 addUserKnob {26 d0 l "" +STARTLINE}
 addUserKnob {26 t1 l "vanishing points"}
 addUserKnob {12 vp1 l "vp 1" t "Expression-linked to a dhPerspGuide vp knob by the menu command."}
 vp1 {-600 900}
 addUserKnob {12 vp2 l "vp 2"}
 vp2 {2600 900}
 addUserKnob {12 vp3 l "vp 3 (vertical)" t "Vanishing point of the upright edges. Linked from a dhPerspGuide whose 'these lines are' is vertical. Leave the third guide off and the solve assumes the lens axis is at the center of frame, as before."}
 vp3 {960 1e9}
 addUserKnob {6 use_vertical l "solve the lens axis from a vertical guide" t "With three mutually perpendicular vanishing points the principal point is the orthocenter of their triangle, so it is solved instead of assumed. Ignored automatically when the verticals are too close to parallel for their vanishing point to mean anything." +STARTLINE}
 addUserKnob {26 axis_note l "" +STARTLINE T "lens axis: center of frame"}
 addUserKnob {26 linked_to l "" t "Which dhPerspGuide drives each vanishing point. Selection order is not click order, so check here before wondering why moving a guide did nothing." +STARTLINE T "vp1: set by hand   vp2: set by hand"}
 addUserKnob {22 link_guides l "solve from guides" t "Normally automatic: two dhPerspGuide nodes anywhere in this node's input chain are picked up on their own, and moving them updates the camera live. Press this only to re-link, or to link two guides that are selected but not connected." T "import dhPersp\ndhPersp.link_guides(nuke.thisNode())" +STARTLINE}
 addUserKnob {22 unlink_guides l unlink t "Keep the current vanishing points as plain numbers and stop following the guides." -STARTLINE T "import dhPersp\ndhPersp.unlink_guides(nuke.thisNode())"}
 addUserKnob {26 status l "" +STARTLINE T ""}
 addUserKnob {20 floor l "3D Floor"}
 addUserKnob {6 show_floor l "show 3D floor" -STARTLINE}
 show_floor true
 addUserKnob {19 gridcolor l color}
 gridcolor {1 0.65 0.1 1}
 addUserKnob {7 gridwidth l "line width" t "Thickness of the grid lines in pixels, held constant wherever they are on the ground." R 0.5 6}
 addUserKnob {6 fade_far l "thin out lines too fine to draw" t "Off, the grid is drawn at full strength all the way to the horizon, and where the lines close up tighter than a pixel the ground fills in solid, which is what they really do. On, each direction dims in proportion to how far apart its own lines are, which keeps the far half of frame from turning into moire at the cost of the grid stopping short of the horizon." +STARTLINE}
 gridwidth 1
 addUserKnob {7 cellsize l "cell size" t "Size of one floor tile, in the working unit set on the Scale tab. The ground is drawn out to the horizon whatever this is; lines too fine to resolve fade out rather than alias." R 0.05 20}
 cellsize 1
 addUserKnob {13 gridoffset l "grid offset" t "Move the grid. X and Z slide it along the ground, in the two directions your guides marked. Y raises and lowers the ground itself: the camera stays at the height on the Scale tab and the ground sits at Y, so raising it brings the floor nearer and spreads the cells down the frame, and lowering it pushes the ground away and bunches them toward the horizon. Use it when the floor in the plate is not at the height the camera height implies."}
 addUserKnob {26 d2 l "" +STARTLINE}
 addUserKnob {4 axis_from l "ground X axis runs toward" t "The geometry cannot tell which horizontal direction is X and which is Z, so there are always two valid cameras. Their yaws are complementary and add up to ninety degrees. If the floor grid looks turned against the plate, switch this. The Horizon tab shows which guide feeds each vanishing point. Pin this to one of the two before animating: automatic decides again on every frame, and because the two answers are ninety degrees apart the frame where it changes its mind puts a ninety degree snap in the move." M {"auto (smaller turn)" "vanishing point 1" "vanishing point 2"}}
 addUserKnob {26 axis_state l "" +STARTLINE T ""}
 addUserKnob {20 scale_tab l Scale}
 addUserKnob {26 t_scale l "" +STARTLINE T "A photograph has no scale of its own. Set the height the camera was at and everything else becomes real."}
 addUserKnob {4 unit l "working unit" t "The unit every length on this node is in: camera height, cell size, grid size, distance and offset. Changing it converts the values you have already set, so the setup does not move." M {feet meters centimeters}}
 addUserKnob {7 camera_height l "camera height" t "Height of the camera above the ground plane, in the working unit. This is the one measurement that gives the solve a real scale. Eye level is about 5.5 ft or 1.7 m, a tripod about 4.5 ft or 1.4 m." R 0.1 40}
 camera_height 5.5
 addUserKnob {26 scale_note l "" +STARTLINE T "1 cell = 1 ft"}
 addUserKnob {26 t_dcc l "" +STARTLINE T "Set the same unit in your 3D package before importing: Maya Preferences, Settings, Linear. Blender Scene Properties, Units, Length."}
 addUserKnob {7 _unit_was +INVISIBLE}
 addUserKnob {20 solve l "Camera Solve"}
 addUserKnob {6 use_known_focal l "I know the focal length" t "Use a measured focal length instead of solving one from the vanishing points. The vanishing points then only set the orientation." +STARTLINE}
 addUserKnob {7 known_focal l "focal (mm)" t "Focal length from the camera report or lens metadata." R 4 300}
 known_focal 35
 addUserKnob {7 filmback l "film back (mm)" t "Horizontal sensor size. Needed to turn millimeters into pixels. Nuke's default 35mm Academy is 24.576." R 4 70}
 filmback 24.576
 addUserKnob {26 dsolve l "" +STARTLINE}
 addUserKnob {26 tsolve l result}
 addUserKnob {26 sanity l "" t "A very small focal length, or a roll of more than a few degrees, almost always means the two guides are not marking two perpendicular sets of parallel edges. Check that each guide's two lines lie along real receding edges in the plate, and that the two guides follow directions at right angles to each other on the ground." +STARTLINE T "A believable solve is roughly 10 to 100mm with roll near zero."}
 addUserKnob {26 verdict l "" +STARTLINE T ""}
 addUserKnob {7 cam_focal l "focal (mm)" +DISABLED}
 cam_focal {{"_f * sqrt(pow(cam.haperture,2)+pow(cam.vaperture,2)) / max(sqrt(width*width + height*height),1e-6)"}}
 addUserKnob {7 cam_rx l "rotate X" +DISABLED}
 cam_rx {{_rx}}
 addUserKnob {7 cam_ry l "rotate Y" +DISABLED}
 cam_ry {{_ry}}
 addUserKnob {7 cam_rz l "rotate Z" +DISABLED}
 cam_rz {{_rz}}
 addUserKnob {26 d3 l "" +STARTLINE}
 addUserKnob {22 export_cam l "export camera" t "Put a copy of the solved camera in the node graph. It stays linked to this node, and carries a 'bake values' button to freeze it." -STARTLINE T "import dhPersp\ndhPersp.export_camera(nuke.thisNode())"}
 addUserKnob {6 _fitted l "" -STARTLINE +INVISIBLE}
 addUserKnob {22 fitformat l "fit to format" t "Re-place the vanishing points against the current format." -STARTLINE T "import dhPersp\ndhPersp.fit_solve_to_format(nuke.thisNode(), quiet=False)"}
 addUserKnob {7 _diag +INVISIBLE}
 _diag {{"sqrt(width*width + height*height)"}}
 addUserKnob {7 _v3d +INVISIBLE}
 _v3d {{"sqrt(pow(vp3.x-width/2,2) + pow(vp3.y-height/2,2))"}}
 addUserKnob {7 _v3use +INVISIBLE}
 _v3use {{"(use_vertical && _v3d > 0.75*_diag && _v3d < 25*_diag) ? 1 : 0"}}
 addUserKnob {7 _tri +INVISIBLE}
 _tri {{"(sqrt(pow(vp1.x-width/2,2) + pow(vp1.y-height/2,2)) < 8*_diag && sqrt(pow(vp2.x-width/2,2) + pow(vp2.y-height/2,2)) < 8*_diag) ? 1 : 0"}}
 addUserKnob {7 _oa1 +INVISIBLE}
 _oa1 {{"vp2.x - vp3.x"}}
 addUserKnob {7 _ob1 +INVISIBLE}
 _ob1 {{"vp2.y - vp3.y"}}
 addUserKnob {7 _oc1 +INVISIBLE}
 _oc1 {{"_oa1*vp1.x + _ob1*vp1.y"}}
 addUserKnob {7 _oa2 +INVISIBLE}
 _oa2 {{"vp1.x - vp3.x"}}
 addUserKnob {7 _ob2 +INVISIBLE}
 _ob2 {{"vp1.y - vp3.y"}}
 addUserKnob {7 _oc2 +INVISIBLE}
 _oc2 {{"_oa2*vp2.x + _ob2*vp2.y"}}
 addUserKnob {7 _odet +INVISIBLE}
 _odet {{"_oa1*_ob2 - _oa2*_ob1"}}
 addUserKnob {7 _ox +INVISIBLE}
 _ox {{"abs(_odet) < 1e-9 ? width/2 : (_oc1*_ob2 - _oc2*_ob1)/_odet"}}
 addUserKnob {7 _oy +INVISIBLE}
 _oy {{"abs(_odet) < 1e-9 ? height/2 : (_oa1*_oc2 - _oa2*_oc1)/_odet"}}
 addUserKnob {7 _v3ok +INVISIBLE}
 _v3ok {{"(_v3use && _tri && sqrt(pow(_ox-width/2,2) + pow(_oy-height/2,2)) < 0.5*_diag) ? 1 : 0"}}
 addUserKnob {7 _px +INVISIBLE}
 _px {{"_v3ok ? _ox : width/2"}}
 addUserKnob {7 _py +INVISIBLE}
 _py {{"_v3ok ? _oy : height/2"}}
 addUserKnob {7 _dx +INVISIBLE}
 _dx {{"vp2.x - vp1.x"}}
 addUserKnob {7 _dy +INVISIBLE}
 _dy {{"vp2.y - vp1.y"}}
 addUserKnob {7 _t +INVISIBLE}
 _t {{"((_px - vp1.x)*_dx + (_py - vp1.y)*_dy) / (max(_dx*_dx + _dy*_dy, 1e-9))"}}
 addUserKnob {7 _vix +INVISIBLE}
 _vix {{"vp1.x + _t*_dx"}}
 addUserKnob {7 _viy +INVISIBLE}
 _viy {{"vp1.y + _t*_dy"}}
 addUserKnob {7 _v1 +INVISIBLE}
 _v1 {{"sqrt(pow(_vix-vp1.x,2) + pow(_viy-vp1.y,2))"}}
 addUserKnob {7 _v2 +INVISIBLE}
 _v2 {{"sqrt(pow(_vix-vp2.x,2) + pow(_viy-vp2.y,2))"}}
 addUserKnob {7 _oivi +INVISIBLE}
 _oivi {{"sqrt(pow(_px-_vix,2) + pow(_py-_viy,2))"}}
 addUserKnob {7 _va +INVISIBLE}
 _va {{"filmback * height / max(width,1e-6)"}}
 addUserKnob {7 _fknown +INVISIBLE}
 _fknown {{"known_focal * sqrt(width*width + height*height) / max(sqrt(filmback*filmback + _va*_va),1e-6)"}}
 addUserKnob {7 _hlen +INVISIBLE}
 _hlen {{"max(sqrt(_dx*_dx + _dy*_dy),1e-9)"}}
 addUserKnob {7 _hsign +INVISIBLE}
 _hsign {{"(_dx < -1e-9 ? -1 : (_dx > 1e-9 ? 1 : (_dy < 0 ? -1 : 1)))"}}
 addUserKnob {7 _s1 +INVISIBLE}
 _s1 {{"_hsign*((vp1.x-_vix)*_dx + (vp1.y-_viy)*_dy)/_hlen"}}
 addUserKnob {7 _s2 +INVISIBLE}
 _s2 {{"_hsign*((vp2.x-_vix)*_dx + (vp2.y-_viy)*_dy)/_hlen"}}
 addUserKnob {7 _fmin +INVISIBLE}
 _fmin {{"pow(0.02*_diag,2)"}}
 addUserKnob {7 _d12 +INVISIBLE}
 _d12 {{"-((vp1.x-_px)*(vp2.x-_px) + (vp1.y-_py)*(vp2.y-_py))"}}
 addUserKnob {7 _d13 +INVISIBLE}
 _d13 {{"-((vp1.x-_px)*(vp3.x-_px) + (vp1.y-_py)*(vp3.y-_py))"}}
 addUserKnob {7 _d23 +INVISIBLE}
 _d23 {{"-((vp2.x-_px)*(vp3.x-_px) + (vp2.y-_py)*(vp3.y-_py))"}}
 addUserKnob {7 _rr1 +INVISIBLE}
 _rr1 {{"sqrt(pow(vp1.x-_px,2) + pow(vp1.y-_py,2))"}}
 addUserKnob {7 _rr2 +INVISIBLE}
 _rr2 {{"sqrt(pow(vp2.x-_px,2) + pow(vp2.y-_py,2))"}}
 addUserKnob {7 _rr3 +INVISIBLE}
 _rr3 {{"sqrt(pow(vp3.x-_px,2) + pow(vp3.y-_py,2))"}}
 addUserKnob {7 _q12 +INVISIBLE}
 _q12 {{"_d12 > _fmin ? max(_rr1,_rr2) : 1e18"}}
 addUserKnob {7 _q13 +INVISIBLE}
 _q13 {{"(_v3use && _d13 > _fmin) ? max(_rr1,_rr3) : 1e18"}}
 addUserKnob {7 _q23 +INVISIBLE}
 _q23 {{"(_v3use && _d23 > _fmin) ? max(_rr2,_rr3) : 1e18"}}
 addUserKnob {7 _qb +INVISIBLE}
 _qb {{"min(_q12, min(_q13, _q23))"}}
 addUserKnob {7 _pair +INVISIBLE}
 _pair {{"_qb > 1e17 ? 0 : (_q12 <= _qb ? 12 : (_q13 <= _qb ? 13 : 23))"}}
 addUserKnob {7 _ill +INVISIBLE}
 _ill {{"(_qb > 8*_diag && _qb < 1e17) ? 1 : 0"}}
 addUserKnob {7 _fsq +INVISIBLE}
 _fsq {{"_pair == 13 ? _d13 : (_pair == 23 ? _d23 : _d12)"}}
 addUserKnob {7 _solveok +INVISIBLE}
 _solveok {{"(use_known_focal || _fsq > pow(0.02*_diag,2)) ? 1 : 0"}}
 addUserKnob {7 _fsolved +INVISIBLE}
 _fsolved {{"sqrt(max(_fsq, pow(0.02*_diag,2)))"}}
 addUserKnob {7 _f +INVISIBLE}
 _f {{"(use_known_focal ? _fknown : _fsolved)"}}
 addUserKnob {7 _rx +INVISIBLE}
 _rx {{"atan((_py - _viy)/_f)*180/3.14159265358979"}}
 addUserKnob {7 _fh +INVISIBLE}
 _fh {{"sqrt(_f*_f + _oivi*_oivi)"}}
 addUserKnob {7 _ry +INVISIBLE}
 _ry {{"atan((axis_from==0 ? (abs(_s2)<abs(_s1) ? _s2 : _s1) : (axis_from==1 ? _s2 : _s1))/_fh)*180/3.14159265358979"}}
 addUserKnob {7 _rz +INVISIBLE}
 _rz {{"(abs(_dx) > 1e-9 ? -atan(_dy/_dx)*180/3.14159265358979 : 0)"}}
 addUserKnob {7 _r1x +INVISIBLE}
 _r1x {{"(vp1.x - _px)/max(_f,1e-6)"}}
 addUserKnob {7 _r1y +INVISIBLE}
 _r1y {{"(vp1.y - _py)/max(_f,1e-6)"}}
 addUserKnob {7 _l1 +INVISIBLE}
 _l1 {{"max(sqrt(_r1x*_r1x + _r1y*_r1y + 1),1e-9)"}}
 addUserKnob {7 _a1x +INVISIBLE}
 _a1x {{"_r1x/_l1"}}
 addUserKnob {7 _a1y +INVISIBLE}
 _a1y {{"_r1y/_l1"}}
 addUserKnob {7 _a1z +INVISIBLE}
 _a1z {{"-1/_l1"}}
 addUserKnob {7 _r2x +INVISIBLE}
 _r2x {{"(vp2.x - _px)/max(_f,1e-6)"}}
 addUserKnob {7 _r2y +INVISIBLE}
 _r2y {{"(vp2.y - _py)/max(_f,1e-6)"}}
 addUserKnob {7 _l2 +INVISIBLE}
 _l2 {{"max(sqrt(_r2x*_r2x + _r2y*_r2y + 1),1e-9)"}}
 addUserKnob {7 _a2x +INVISIBLE}
 _a2x {{"_r2x/_l2"}}
 addUserKnob {7 _a2y +INVISIBLE}
 _a2y {{"_r2y/_l2"}}
 addUserKnob {7 _a2z +INVISIBLE}
 _a2z {{"-1/_l2"}}
 addUserKnob {7 _cx +INVISIBLE}
 _cx {{"_a1y*_a2z - _a1z*_a2y"}}
 addUserKnob {7 _cy +INVISIBLE}
 _cy {{"_a1z*_a2x - _a1x*_a2z"}}
 addUserKnob {7 _cz +INVISIBLE}
 _cz {{"_a1x*_a2y - _a1y*_a2x"}}
 addUserKnob {7 _cl +INVISIBLE}
 _cl {{"max(sqrt(_cx*_cx + _cy*_cy + _cz*_cz),1e-9) * (_cy < 0 ? -1 : 1)"}}
 addUserKnob {7 _nx +INVISIBLE}
 _nx {{"_cx/_cl"}}
 addUserKnob {7 _ny +INVISIBLE}
 _ny {{"_cy/_cl"}}
 addUserKnob {7 _nz +INVISIBLE}
 _nz {{"_cz/_cl"}}
 addUserKnob {7 _e2x +INVISIBLE}
 _e2x {{"_ny*_a1z - _nz*_a1y"}}
 addUserKnob {7 _e2y +INVISIBLE}
 _e2y {{"_nz*_a1x - _nx*_a1z"}}
 addUserKnob {7 _e2z +INVISIBLE}
 _e2z {{"_nx*_a1y - _ny*_a1x"}}
 addUserKnob {7 _e2n +INVISIBLE}
 _e2n {{"max(sqrt(_e2x*_e2x + _e2y*_e2y + _e2z*_e2z),1e-12) * ((_e2x*_a2x + _e2y*_a2y + _e2z*_a2z) < 0 ? -1 : 1)"}}
 addUserKnob {7 _e1x +INVISIBLE}
 _e1x {{"_ny*_a2z - _nz*_a2y"}}
 addUserKnob {7 _e1y +INVISIBLE}
 _e1y {{"_nz*_a2x - _nx*_a2z"}}
 addUserKnob {7 _e1z +INVISIBLE}
 _e1z {{"_nx*_a2y - _ny*_a2x"}}
 addUserKnob {7 _e1n +INVISIBLE}
 _e1n {{"max(sqrt(_e1x*_e1x + _e1y*_e1y + _e1z*_e1z),1e-12) * ((_e1x*_a1x + _e1y*_a1y + _e1z*_a1z) < 0 ? -1 : 1)"}}
 addUserKnob {7 _keep1 +INVISIBLE}
 _keep1 {{"_rr1 <= _rr2 ? 1 : 0"}}
 addUserKnob {7 _u1x +INVISIBLE}
 _u1x {{"_keep1 ? _a1x : _e1x/_e1n"}}
 addUserKnob {7 _u1y +INVISIBLE}
 _u1y {{"_keep1 ? _a1y : _e1y/_e1n"}}
 addUserKnob {7 _u1z +INVISIBLE}
 _u1z {{"_keep1 ? _a1z : _e1z/_e1n"}}
 addUserKnob {7 _u2x +INVISIBLE}
 _u2x {{"_keep1 ? _e2x/_e2n : _a2x"}}
 addUserKnob {7 _u2y +INVISIBLE}
 _u2y {{"_keep1 ? _e2y/_e2n : _a2y"}}
 addUserKnob {7 _u2z +INVISIBLE}
 _u2z {{"_keep1 ? _e2z/_e2n : _a2z"}}
 addUserKnob {20 howto l "How to use"}
 addUserKnob {26 howto_h l "" +STARTLINE T "<b>dhPerspSolve turns the guides into a camera</b>"}
 addUserKnob {26 howto_s l "" +STARTLINE T "<b>1.</b> Connect this under two or three <b>dhPerspGuide</b> nodes. It links itself; the Horizon tab says which guide feeds which vanishing point.<br><b>2.</b> Read the verdict on the <b>Camera Solve</b> tab. It says whether the guides describe a camera that can exist, and what is wrong if not.<br><b>3.</b> Check the floor. If the grid lies flat on the ground in the plate and runs along the same directions, the solve is right. If it looks turned, set <i>these lines are</i> on your guides, or change <i>ground X axis runs toward</i>.<br><b>4.</b> Set the <b>camera height</b> on the Scale tab. Eye level is about 5.5 ft, a tripod about 4.5 ft. Set <i>cell size</i> to something you can measure in the plate and adjust the height until the cells match.<br><b>5.</b> Press <b>export camera</b>."}
 addUserKnob {26 howto_d l "" +STARTLINE}
 addUserKnob {26 howto_n l "" +STARTLINE T "<b>If the focal length looks wrong.</b> The verdict line says why. The usual cause is two guides following the same direction on the ground, or a line that is not on a receding edge. A shot looking straight down a street, where one direction barely converges, cannot be solved from guides alone: tick <i>I know the focal length</i> and let the guides set the orientation only.<br><br><b>Lens distortion, if you ever need it.</b> Every vanishing point here comes from a straight line, and a lens bends straight edges a little, most in the corners of frame and most on a wide one. Usually too small to matter. On a wide plate that will not settle, trace nearer the middle of frame, and if that is not enough put a LensDistortion above the guides.<br><br><b>Scale.</b> A photograph carries no scale, so camera height is the one measurement that gives it one. Changing it moves nothing in the solve: the focal length, the angles and the lens axis are identical at any height. It only decides how big the world is.<br><br><b>Before exporting to Maya or Blender.</b> Set the same linear unit at the other end, and set <i>these lines are</i> on both level guides so the X and Z axes are pinned rather than guessed.<br><br><b>Animation.</b> Key the guide points and the camera follows, frame by frame. Pin the axis first, or the automatic choice can flip ninety degrees mid shot. <i>bake values</i> keeps the whole move."}
}
 Input {
  inputs 0
  name Input1
 }
set Nbff08000 [stack 0]
push $Nbff08000
 Expression {
  temp_name0 dx
  temp_expr0 "(x + 0.5 - parent._px)/max(parent._f,1e-6)"
  temp_name1 dy
  temp_expr1 "(y + 0.5 - parent._py)/max(parent._f,1e-6)"
  temp_name2 dd
  temp_expr2 "dx*parent._nx + dy*parent._ny - parent._nz"
  temp_name3 hh
  temp_expr3 "max(parent.camera_height - parent.gridoffset.y,1e-9)"
  expr0 "-hh*(dx*parent._a1x + dy*parent._a1y - parent._a1z)/(abs(dd) < 1e-9 ? 1e-9 : dd)"
  expr1 "-hh*(dx*parent._a2x + dy*parent._a2y - parent._a2z)/(abs(dd) < 1e-9 ? 1e-9 : dd)"
  expr2 dd
  expr3 1
  name groundxz
 }
 Expression {
  temp_name0 px1
  temp_expr0 "parent.cellsize*max(parent._f,1e-6)*abs(b)/(max(parent.camera_height - parent.gridoffset.y,1e-9)*max(sqrt(pow(parent._a1x + r*parent._nx/max(parent.camera_height - parent.gridoffset.y,1e-9),2) + pow(parent._a1y + r*parent._ny/max(parent.camera_height - parent.gridoffset.y,1e-9),2)),1e-12))"
  temp_name1 pz1
  temp_expr1 "parent.cellsize*max(parent._f,1e-6)*abs(b)/(max(parent.camera_height - parent.gridoffset.y,1e-9)*max(sqrt(pow(parent._a2x + g*parent._nx/max(parent.camera_height - parent.gridoffset.y,1e-9),2) + pow(parent._a2y + g*parent._ny/max(parent.camera_height - parent.gridoffset.y,1e-9),2)),1e-12))"
  temp_name2 mx
  temp_expr2 "parent.fade_far ? (clamp(parent.gridwidth/2 + 0.5 - abs(clamp((r - parent.gridoffset.x)/max(parent.cellsize,1e-6), -1e7, 1e7) - floor(clamp((r - parent.gridoffset.x)/max(parent.cellsize,1e-6), -1e7, 1e7) + 0.5))*px1, 0, 1))*(clamp((sqrt(px1/max(parent.gridwidth,0.1)) - 1.2)/3.2, 0, 1)) : ((clamp((px1 - 2*max(parent.gridwidth,0.1))/(2*max(parent.gridwidth,0.1)), 0, 1))*(clamp(parent.gridwidth/2 + 0.5 - abs(clamp((r - parent.gridoffset.x)/max(parent.cellsize,1e-6), -1e7, 1e7) - floor(clamp((r - parent.gridoffset.x)/max(parent.cellsize,1e-6), -1e7, 1e7) + 0.5))*px1, 0, 1)) + (1 - (clamp((px1 - 2*max(parent.gridwidth,0.1))/(2*max(parent.gridwidth,0.1)), 0, 1)))*(clamp(parent.gridwidth/max(px1,1e-9), 0, 1)))"
  temp_name3 mz
  temp_expr3 "parent.fade_far ? (clamp(parent.gridwidth/2 + 0.5 - abs(clamp((g - parent.gridoffset.z)/max(parent.cellsize,1e-6), -1e7, 1e7) - floor(clamp((g - parent.gridoffset.z)/max(parent.cellsize,1e-6), -1e7, 1e7) + 0.5))*pz1, 0, 1))*(clamp((sqrt(pz1/max(parent.gridwidth,0.1)) - 1.2)/3.2, 0, 1)) : ((clamp((pz1 - 2*max(parent.gridwidth,0.1))/(2*max(parent.gridwidth,0.1)), 0, 1))*(clamp(parent.gridwidth/2 + 0.5 - abs(clamp((g - parent.gridoffset.z)/max(parent.cellsize,1e-6), -1e7, 1e7) - floor(clamp((g - parent.gridoffset.z)/max(parent.cellsize,1e-6), -1e7, 1e7) + 0.5))*pz1, 0, 1)) + (1 - (clamp((pz1 - 2*max(parent.gridwidth,0.1))/(2*max(parent.gridwidth,0.1)), 0, 1)))*(clamp(parent.gridwidth/max(pz1,1e-9), 0, 1)))"
  expr0 "b < 0 ? max(mx,mz) : 0"
  expr1 "b < 0 ? max(mx,mz) : 0"
  expr2 "b < 0 ? max(mx,mz) : 0"
  expr3 "b < 0 ? max(mx,mz) : 0"
  name gridmask
 }
 Multiply {
  value {{parent.gridcolor.r} {parent.gridcolor.g} {parent.gridcolor.b} {parent.gridcolor.a}}
  name gridtint
 }
push $Nbff08000
 Merge2 {
  inputs 2
  name overlay
 }
 Switch {
  inputs 2
  which {{!parent.show_floor}}
  name floor_onoff
 }
 Expression {
  temp_name0 hz
  temp_expr0 "(parent.show_horizon ? clamp((parent.horizonwidth/2 + 0.5) - (abs((parent.vp2.y-parent.vp1.y)*(x+0.5-parent.vp1.x) - (parent.vp2.x-parent.vp1.x)*(y+0.5-parent.vp1.y))/max(sqrt((parent.vp2.y-parent.vp1.y)*(parent.vp2.y-parent.vp1.y) + (parent.vp2.x-parent.vp1.x)*(parent.vp2.x-parent.vp1.x)),1e-6)),0,1) : 0) * parent.horizoncolor.a"
  expr0 "parent.horizoncolor.r*hz + r*(1-hz)"
  expr1 "parent.horizoncolor.g*hz + g*(1-hz)"
  expr2 "parent.horizoncolor.b*hz + b*(1-hz)"
  expr3 "max(hz, a)"
  name horizon_line
 }
 Output {
  name Output1
 }
 Camera {
  inputs 0
  translate {0 {{parent.camera_height}} 0}
  rotate {{parent._rx} {parent._ry} {parent._rz}}
  focal {{"parent._f * sqrt(pow(haperture,2)+pow(vaperture,2)) / max(sqrt(parent.width*parent.width + parent.height*parent.height),1e-6)"}}
  win_translate {{"2*(parent._px - parent.width/2)/parent.width"} {"2*(parent._py - parent.height/2)/parent.height"}}
  haperture {{parent.filmback}}
  vaperture {{parent._va}}
  name cam
 }
end_group
