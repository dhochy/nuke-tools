arent.pin12 ? clamp((parent.linewidth/2 + 0.5) - (abs((parent.add12.y-parent.vp.y)*(x+0.5-parent.vp.x) - (parent.add12.x-parent.vp.x)*(y+0.5-parent.vp.y))/max(sqrt(pow(parent.add12.y-parent.vp.y,2) + pow(parent.add12.x-parent.vp.x,2)),1e-6)),0,1) : (parent._Ln14 > 1e-9 ? clamp((parent.linewidth/2 + 0.5) - (abs((parent.add12.y-parent.add12b.y)*(x+0.5-parent.add12b.x) - (parent.add12.x-parent.add12b.x)*(y+0.5-parent.add12b.y))/max(sqrt(parent._Ln14),1e-6)),0,1) : 0)) : 0))) * parent.opacity * parent.linecolor.a"
  expr0 "parent.linecolor.r * cov"
  expr1 "parent.linecolor.g * cov"
  expr2 "parent.linecolor.b * cov"
  expr3 cov
  name lines
 }
set N89c33900 [stack 0]
push $N89c33900
push $N8a508d00
 Merge2 {
  inputs 2
  name overlay
 }
