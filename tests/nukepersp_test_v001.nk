 addUserKnob {7 _Sbc +INVISIBLE}
 _Sbc {{"_Lw1*_Lb1*_Lc1 + _Lw2*_Lb2*_Lc2 + _Lw3*_Lb3*_Lc3 + _Lw4*_Lb4*_Lc4 + _Lw5*_Lb5*_Lc5 + _Lw6*_Lb6*_Lc6 + _Lw7*_Lb7*_Lc7 + _Lw8*_Lb8*_Lc8 + _Lw9*_Lb9*_Lc9 + _Lw10*_Lb10*_Lc10 + _Lw11*_Lb11*_Lc11 + _Lw12*_Lb12*_Lc12 + _Lw13*_Lb13*_Lc13 + _Lw14*_Lb14*_Lc14"}}
 addUserKnob {7 _Scc +INVISIBLE}
 _Scc {{"_Lw1*_Lc1*_Lc1 + _Lw2*_Lc2*_Lc2 + _Lw3*_Lc3*_Lc3 + _Lw4*_Lc4*_Lc4 + _Lw5*_Lc5*_Lc5 + _Lw6*_Lc6*_Lc6 + _Lw7*_Lc7*_Lc7 + _Lw8*_Lc8*_Lc8 + _Lw9*_Lc9*_Lc9 + _Lw10*_Lc10*_Lc10 + _Lw11*_Lc11*_Lc11 + _Lw12*_Lc12*_Lc12 + _Lw13*_Lc13*_Lc13 + _Lw14*_Lc14*_Lc14"}}
 addUserKnob {7 _Snum +INVISIBLE}
 _Snum {{"max(_Saa + _Sbb, 1e-9)"}}
 addUserKnob {7 _Sdet +INVISIBLE}
 _Sdet {{"_Saa*_Sbb - _Sab*_Sab"}}
 addUserKnob {7 _Spx +INVISIBLE}
 _Spx {{"abs(_Sdet) < 1e-12 ? width/2 : (_Sab*_Sbc - _Sac*_Sbb)/_Sdet"}}
 addUserKnob {7 _Spy +INVISIBLE}
 _Spy {{"abs(_Sdet) < 1e-12 ? height/2 : (_Sac*_Sab - _Saa*_Sbc)/_Sdet"}}
 addUserKnob {7 _Sdisc +INVISIBLE}
 _Sdisc {{"sqrt(pow(_Saa-_Sbb,2) + 4*_Sab*_Sab)"}}
 addUserKnob {7 _Slam +INVISIBLE}
 _Slam {{"(_Saa + _Sbb - _Sdisc)/2"}}
 addUserKnob {7 _Sn1 +INVISIBLE}
 _Sn1 {{"_Sab*_Sab + (_Slam-_Saa)*(_Slam-_Saa)"}}
 addUserKnob {7 _Sn2 +INVISIBLE}
 _Sn2 {{"(_Slam-_Sbb)*(_Slam-_Sbb) + _Sab*_Sab"}}
 addUserKnob {7 _Sdx +INVISIBLE}
 _Sdx {{"_Sn1 >= _Sn2 ? _Sab : _Slam-_Sbb"}}
 addUserKnob {7 _Sdy +INVISIBLE}
 _Sdy {{"_Sn1 >= _Sn2 ? _Slam-_Saa : _Sab"}}
 addUserKnob {7 _Sdn +INVISIBLE}
 _Sdn {{"max(sqrt(_Sdx*_Sdx + _Sdy*_Sdy),1e-12)"}}
 addUserKnob {7 _Sdot +INVISIBLE}
 _Sdot {{"(_Spx - width/2)*_Sdx + (_Spy - height/2)*_Sdy"}}
 addUserKnob {7 _Ssg +INVISIBLE}
 _Ssg {{"abs(_Sdet) < 1e-12 ? (_Sdx < -1e-12 ? -1 : (_Sdx > 1e-12 ? 1 : (_Sdy < 0 ? -1 : 1))) : (_Sdot < 0 ? -1 : 1)"}}
 addUserKnob {7 _Sdiag +INVISIBLE}
 _Sdiag {{"sqrt(width*width + height*height)"}}
 addUserKnob {7 _Srms +INVISIBLE}
 _Srms {{"sqrt(max((_Scc + _Sac*_Spx + _Sbc*_Spy)/_Snum, 0))"}}
 addUserKnob {7 _Sreach +INVISIBLE}
 _Sreach {{"max(sqrt(pow(_Spx-width/2,2) + pow(_Spy-height/2,2)), _Sdiag)"}}
 addUserKnob {7 _Sang +INVISIBLE}
 _Sang {{_Srms/_Sreach}}
 addUserKnob {7 _Sfar +INVISIBLE}
 _Sfar {{"(abs(_Sdet) < 1e-12 || _Sreach > 100*_Sdiag || _Sang > 0.01) ? 1 : 0"}}
}
