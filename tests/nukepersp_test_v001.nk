Group {
 name dhPerspGuide3
 help "Marks one direction in the scene.\n\nDrag its two lines onto two edges that are parallel in the real world but converge on screen: two curbs, two window sills, two building corners. Drag the ends as far apart as the edge lets you: the longer the line, the more accurate the answer, and it is the biggest thing you control. Where those lines cross is that direction's vanishing point, and that is the number dhPerspSolve reads.\n\nSay which sort of direction it is with 'these lines are'. Ground runs away from you, across runs left to right in front of you, vertical is upright.\n\nA camera solve needs two of these marking level directions, plus optionally a third set to vertical. The vertical one is worth adding whenever it is easy: it finds the real lens axis instead of assuming the center of frame, and on a shot with only one usable level direction, which is any street running away from you, it is the thing that makes a solve possible at all.\n\nStack them under the plate and drop a dhPerspSolve at the bottom. It picks them up on its own.\n\nWorth knowing: this reads a straight edge as a straight line, and a real lens bends them a little, most in the corners of frame and most on a wide lens. Usually too small to matter. If a wide plate gives an answer you cannot make sit right, undistorting it first is the thing to try."
 onCreate "try:\n    import dhPersp\n    dhPersp.on_create(nuke.thisNode())\nexcept Exception:\n    pass"
 knobChanged "try:\n    import dhPersp\n    dhPersp.on_knob_changed(nuke.thisNode(), nuke.thisKnob())\nexcept Exception:\n    pass"
 updateUI "try:\n    import dhPersp\n    dhPersp.on_update_ui(nuke.thisNode())\nexcept Exception:\n    pass"
 xpos 288
 ypos 276
 addUserKnob {20 main l PerspLines}
 addUserKnob {7 _build l "" -STARTLINE +INVISIBLE}
 _build 33
 addUserKnob {4 role l "these lines are" t "Which direction in the scene these two lines follow.\n\nground: runs away from you into the picture. Curbs, road markings, the seams in paving, the long side of a building going away from you.\n\nacross: runs left to right in front of you. The top of a wall facing the camera, a window sill or a roofline on it. It does not have to be at ground level and it does not have to be on the ground: every level edge running the same way shares a vanishing point whatever height it is at, and a long clean edge up in the air is usually easier to trace than a curb with people standing on it.\n\nvertical: upright. Building corners, door frames, lamp posts.\n\nA solve needs one ground and one across. Saying which is which also fixes which way the exported scene's X and Z axes run, so the camera arrives in Maya or Blender the right way round, and it stops the axis choice flipping in the middle of an animated solve. A vertical guide is optional and lets the solve work out where the lens axis really sits; with three guides connected the upright one is recognized from its own lines." M {ground across vertical}}
 addUserKnob {19 linecolor l color t "Set on its own from 'these lines are': red for ground, green for across, blue for vertical. The buttons override it, for a plate where one of those disappears into the picture; that does not change the role, only the color."}
 linecolor {1 0 0 1}
 addUserKnob {6 linecolor_panelDropped l "panel dropped state" -STARTLINE +HIDDEN}
 addUserKnob {22 setR l R -STARTLINE T "nuke.thisNode()\['linecolor'].setValue(\[1, 0, 0, 1])"}
 addUserKnob {22 setG l G -STARTLINE T "nuke.thisNode()\['linecolor'].setValue(\[0, 1, 0, 1])"}
 addUserKnob {22 setB l B -STARTLINE T "nuke.thisNode()\['linecolor'].setValue(\[0, 0, 1, 1])"}
 addUserKnob {7 opacity}
 opacity 1
 addUserKnob {7 linewidth l "line width" R 0.5 10}
 linewidth 2
 addUserKnob {6 lines_only l "output lines only" +STARTLINE}
 addUserKnob {26 d1 l "" +STARTLINE}
 addUserKnob {26 l1 l "line 1"}
 addUserKnob {12 p1a l "point A"}
 p1a {364.2000122 -87.19999695}
 addUserKnob {12 p1b l "point B"}
 p1b {1007.400024 180.8000029}
 addUserKnob {26 l2 l "line 2"}
 addUserKnob {12 p2a l "point A"}
 p2a {673.5999756 -91.40000153}
 addUserKnob {12 p2b l "point B"}
 p2b {132.1999969 212.1999969}
 addUserKnob {22 fitformat l "fit to format" t "Re-place the points against the current format. Uses the connected image if there is one, otherwise the project format." T "import dhPersp\ndhPersp.fit_to_format(nuke.thisNode(), quiet=False)" +STARTLINE}
 addUserKnob {6 _fitted l "" -STARTLINE +INVISIBLE}
 _fitted true
 addUserKnob {7 _fitw +INVISIBLE}
 _fitw 1024
 addUserKnob {7 _fith +INVISIBLE}
 _fith 683
 addUserKnob {26 d2 l "" +STARTLINE}
 addUserKnob {26 status l "" +STARTLINE T ""}
 addUserKnob {12 vp l "vanishing point" t "Fitted from every line on this node that has length: the two base lines and any added ones. Two lines give exactly their intersection; more than two give the point that sits closest to all of them, which no single mis-traced edge can drag around. Lines that barely converge meet so far away that the meeting point is not a real quantity, so past a hundred frame diagonals this reports their common direction placed very far along it instead, which is the same line and is stable. dhPerspSolve links to this." +DISABLED}
 vp {{"_Sfar ? width/2 + _Ssg*_Sdx/_Sdn*1e6 : _Spx"} {"_Sfar ? height/2 + _Ssg*_Sdy/_Sdn*1e6 : _Spy"}}
 addUserKnob {12 vp_drag l "drag vanishing point" t "Drag this to aim both lines at a new vanishing point. Each line swings about its point A, which stays put, so put those on features you trust."}
 vp_drag {537.4102076 -15.02908357}
 addUserKnob {26 d3 l "" +STARTLINE}
 addUserKnob {26 l3 l "additional lines"}
 addUserKnob {22 addline l "add line" t "Add another line along the same direction, with its own point A and point B, feeding the vanishing point along with the first two: more lines traced well means a better fit. Tick 'follows the vanishing point' on it instead and it goes back to being a single point drawn out from the vanishing point, which cannot move the answer either way. Up to 12." -STARTLINE T "import dhPersp\ndhPersp.add_line(nuke.thisNode())"}
 addUserKnob {22 clearlines l "clear all" -STARTLINE T "import dhPersp\ndhPersp.clear_lines(nuke.thisNode())"}
 addUserKnob {6 use_add1 l "" -STARTLINE +HIDDEN}
 addUserKnob {12 add1 l "line 1  A" +HIDDEN}
 add1 {1024 400}
 addUserKnob {12 add1b l B -STARTLINE +HIDDEN}
 add1b {1024 400}
 addUserKnob {22 del1 l delete -STARTLINE +HIDDEN T "import dhPersp\ndhPersp.del_line(1, nuke.thisNode())"}
 addUserKnob {6 pin1 l "follows the vanishing point" t "On, this line runs out from the vanishing point through its one point: a prediction of where an edge should lie, useful for checking the fit against another feature. It cannot move the vanishing point, because it was drawn from it.\n\nOff, it has two points and is a line in its own right, and it votes on the vanishing point along with the others. More lines traced well give a better answer; a line traced badly makes a worse one, so trace it along a real edge or leave this on." +HIDDEN +STARTLINE}
